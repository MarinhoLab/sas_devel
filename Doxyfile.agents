# Doxyfile.agents — agent/AI documentation for SmartArmStack (sas_devel)
#
# Minimal Doxygen configuration that documents the machine-oriented
# documentation of this repository (AGENTS.md guides and the CMake
# cheatsheet) as a standalone section of the website, separate from the
# human-facing API docs generated by Doxyfile:
#
#   Doxyfile        -> docs/html/          (https://marinholab.github.io/sas_devel/)
#   Doxyfile.agents -> docs/html/agents/   (https://marinholab.github.io/sas_devel/agents/)
#
# Both builds run in .github/workflows/pages.yml; the Pages upload path is
# docs/html, which then contains the agents/ subdirectory.
#
# The markdown files listed in INPUT are plain documentation pages, so the
# C++/Python parser settings are left at their defaults (and nothing but
# markdown is parsed).

PROJECT_NAME           = "sas_devel — Agent documentation"
PROJECT_BRIEF          = "Operational guides for AI agents and maintainers: repository conventions, build/test workflow, and per-package agent notes."

OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
HTML_OUTPUT            = html/agents

INPUT                  = AGENTS.md \
                         cheatsheet.md \
                         src/sas_robot_driver/AGENTS.md \
                         src/sas_robot_driver_gazebo/convert/AGENTS.md

MARKDOWN_SUPPORT       = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO

# SEARCHENGINE disabled: the section is four static pages, in-page search is
# not useful and it avoids pulling in the search assets for this tiny site.
SEARCHENGINE           = NO
